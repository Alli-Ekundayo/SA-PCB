{
  "multistart": {
    "binary": "./sa",
    "placement": "designs/bm1",
    "iterations_outer": 2500,
    "iterations_inner": 25,
    "initial_temperature": 0.025,
    "runs": 8,
    "workers": 4,
    "timeout_sec": 600,
    "seed": 42,
    "seed_option": "",
