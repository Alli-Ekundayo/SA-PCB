    "lam_enabled": true,
    "lamtemp_update": 0.85,
    "base_lam": 0.44,
    "initial_move_radius": 4.0,
    "adaptive_schedule": {
      "enabled": true,
      "acceptance_target": 0.5,
      "restart_on_plateau": true,
      "plateau_window": 50,
      "plateau_epsilon": 1e-06
    }
